{
  // THE SERVERLESS FUNCTIONS' OWN COMPILER SETTINGS.
  //
  // `@vercel/node` type-checks each function at deploy time with the nearest
  // tsconfig.json walking UP from the entrypoint. Without this file that walk
  // reaches the root tsconfig.json, a solution file with no compilerOptions,
  // so the functions compile at TypeScript's bare defaults with `strict` off.
  // That is how a correct discriminated-union narrowing fails ONLY on deploy.
  // These settings mirror the app's strictness, and `npm run typecheck` runs
  // this project too, so the two cannot disagree.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    // Deliberately NOT `isolatedModules`: @vercel/node does not transpile
    // file by file, and some server libraries ship ambient const enums
    // (e.g. @node-rs/argon2's Algorithm) that isolatedModules forbids.
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["**/*.ts"]
}
