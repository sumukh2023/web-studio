#!/bin/sh
# Two-layer gate. See CLAUDE.md. Emergency bypass: git push --no-verify
echo "» impeccable: scanning src/ for UI anti-patterns…"
if ! npx --yes impeccable@2.3.2 detect src/; then
  echo "\n✗ Push blocked: fix the anti-patterns above."
  exit 1
fi
echo "✓ No anti-patterns found."
echo "» design-process gate…"
if ! node scripts/verify-design-process.mjs; then
  echo "\n✗ Push blocked: design-process gate failed (see above)."
  exit 1
fi
